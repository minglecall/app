{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/r2-test.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/health.ts": { "maxDuration": 10, "memory": 256 },
    "api/admin/infra-config.ts": { "maxDuration": 30, "memory": 512 },
    "api/storage/config.ts": { "maxDuration": 15, "memory": 256 },
    "api/storage/test-connection.ts": { "maxDuration": 30, "memory": 1024 },
    "api/storage/presigned-url.ts": { "maxDuration": 30, "memory": 512 },
    "api/livekit/config.ts": { "maxDuration": 15, "memory": 256 },
    "api/livekit/token.ts": { "maxDuration": 30, "memory": 512 },
    "api/[...path].ts": {
      "maxDuration": 15,
      "memory": 256
    }
  }
}
