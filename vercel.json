{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/admin/infra-config.ts": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/[...path].ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "supabase_schema.sql"
    }
  }
}
