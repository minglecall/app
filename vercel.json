{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/r2-test.js": { "maxDuration": 30, "memory": 512 },
    "api/health.js": { "maxDuration": 10, "memory": 256 },
    "api/ping.js": { "maxDuration": 10, "memory": 256 },
    "api/auth/*.ts": { "maxDuration": 30, "memory": 512 },
    "api/users/*.ts": { "maxDuration": 30, "memory": 512 },
    "api/users/me/delete.ts": { "maxDuration": 30, "memory": 512 },
    "api/presence/*.ts": { "maxDuration": 15, "memory": 256 },
    "api/messages/**/*.ts": { "maxDuration": 30, "memory": 512 },
    "api/v1/[...path].ts": { "maxDuration": 30, "memory": 1024 },
    "api/gifts/send.ts": { "maxDuration": 30, "memory": 512 },
    "api/calls/*.ts": { "maxDuration": 30, "memory": 512 },
    "api/teamleader/[...path].ts": { "maxDuration": 30, "memory": 1024 },
    "api/supabase/*.ts": { "maxDuration": 15, "memory": 256 },
    "api/admin/infra-config.ts": { "maxDuration": 30, "memory": 512 },
    "api/admin/create-team-leader.ts": { "maxDuration": 30, "memory": 512 },
    "api/admin/api-health.ts": { "maxDuration": 15, "memory": 256 },
    "api/storage/config.ts": { "maxDuration": 15, "memory": 256 },
    "api/storage/test-connection.js": { "maxDuration": 30, "memory": 512 },
    "api/storage/presigned-url.ts": { "maxDuration": 30, "memory": 512 },
    "api/livekit/config.ts": { "maxDuration": 15, "memory": 256 },
    "api/livekit/token.ts": { "maxDuration": 30, "memory": 512 },
    "api/[...path].js": { "maxDuration": 10, "memory": 256 }
  }
}
